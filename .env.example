# Copy this file to .env. Local providers are the only enabled defaults.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Keep Ollama for the free local path. Set azure_openai only after configuring Azure below.
MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_FALLBACK_MODEL=qwen2.5:3b
OLLAMA_REQUEST_TIMEOUT_SECONDS=600
MODEL_MAX_OUTPUT_TOKENS=1000
# 0 allows healthy streams to finish without a total time limit. Stop still cancels.
ARCHITECTURE_GENERATION_TIMEOUT_SECONDS=0

DATABASE_URL=sqlite+aiosqlite:///./data/architect_ai.db
GENERATED_PROJECTS_DIR=./generated_projects
KNOWLEDGE_BASE_DIR=./knowledge_base
KNOWLEDGE_CHUNK_SIZE=1200
KNOWLEDGE_CHUNK_OVERLAP=200
KNOWLEDGE_RETRIEVAL_RESULTS=4
KNOWLEDGE_UPLOAD_MAX_BYTES=2000000
LOG_LEVEL=INFO

# Azure integrations are optional and disabled. Never add real secrets here.
AZURE_INTEGRATIONS_ENABLED=false
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_AI_SEARCH_ENDPOINT=
AZURE_AI_SEARCH_API_KEY=
AZURE_AI_SEARCH_INDEX=
AZURE_AI_SEARCH_API_VERSION=2025-09-01

# AutoGen executes every local agent model call (including LangGraph workflow stages).
AUTOGEN_EXPERIMENTAL_ENABLED=true

# LangGraph orchestrates Planner -> Research -> Architect; AutoGen executes each stage.
LANGGRAPH_ORCHESTRATION_ENABLED=true

